# ==============================================================================
# BookByShow (https://bookbyshow.com) - Environment Configuration Template
# Copy this file to .env.local for local development, or add variables to Vercel.
# Note: All integrations have graceful fallback modes if API keys are omitted.
# ==============================================================================

# 1. Google Gemini AI (Powers ShowScout Concierge & Evening Planner)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Ticketmaster Discovery API (Live Nationwide Stadium Tours & Concerts)
# Register a free developer app at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# 3. The Movie Database (TMDB) API (Daily Theatrical Box Office & Cast Data)
# Register a free developer key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 4. Google AdSense (Display Ad Monetization)
# Format: ca-pub-XXXXXXXXXXXXXXXX (from your Google AdSense console)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 5. Resend Email Service (Powers Price Drop Email Alerts)
# Register a free account (3,000 emails/mo) at: https://resend.com/
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@bookbyshow.com

# 6. Canonical Site URL (Used for OpenGraph, Twitter Cards, Canonical SEO tags)
NEXT_PUBLIC_APP_URL=https://bookbyshow.com

# 7. Affiliate Network Identifiers (Impact.com, Partnerize, FlexOffers, CJ)
# Leave blank to use default BookByShow network sub-IDs
NEXT_PUBLIC_AFFILIATE_TICKETMASTER_ID=bookbyshow-tm
NEXT_PUBLIC_AFFILIATE_SEATGEEK_ID=bookbyshow-sg
NEXT_PUBLIC_AFFILIATE_STUBHUB_ID=bookbyshow-sh
NEXT_PUBLIC_AFFILIATE_FANDANGO_ID=bookbyshow-fnd
NEXT_PUBLIC_AFFILIATE_AMC_ID=bookbyshow-amc
NEXT_PUBLIC_AFFILIATE_CINEMARK_ID=bookbyshow-cnk
NEXT_PUBLIC_AFFILIATE_REGAL_ID=bookbyshow-rgl