# ==============================================================================
# BookByShow Affiliate & API Configuration
# ==============================================================================

# Ticketmaster via Impact.com
# Option A: Leave unset to use default www.ticketmaster.com URLs with Impact Universal Tag auto-transformation
# Option B: Paste your unique Impact Ticketmaster tracking link (from Impact Dashboard > Brands > Ticketmaster > Tracking Link)
# Example: NEXT_PUBLIC_IMPACT_TICKETMASTER_URL=https://ticketmaster.evyy.net/c/1234567/12345/1234
NEXT_PUBLIC_IMPACT_TICKETMASTER_URL=

# Impact Publisher / Media Partner ID (Impact.com)
NEXT_PUBLIC_AFFILIATE_TICKETMASTER_ID=7792432

# (Optional) Ticketmaster Discovery API Key (from developer.ticketmaster.com)
# Used for syncing live real-time event feeds and ticket availability
TICKETMASTER_API_KEY=

# (Optional) The Movie Database (TMDB) API Key (from themoviedb.org/settings/api)
# Used for live real-time theatrical "Now Playing" and "Upcoming" movie feeds
TMDB_API_KEY=

# SeatGeek via Impact.com
# SeatGeek operates its affiliate program directly on Impact.com.
# Once approved under Brands > SeatGeek on Impact, paste your SeatGeek tracking link below.
# Example: NEXT_PUBLIC_IMPACT_SEATGEEK_URL=https://seatgeek.pxf.io/c/7792432/XXXX/XXXX
NEXT_PUBLIC_IMPACT_SEATGEEK_URL=
NEXT_PUBLIC_AFFILIATE_SEATGEEK_ID=7792432

# StubHub via Partnerize
# StubHub North America operates on the Partnerize platform (https://stubhub.com/affiliates).
# Example: NEXT_PUBLIC_PARTNERIZE_STUBHUB_URL=https://stubhub.prf.hn/click/camref:XXXX
NEXT_PUBLIC_PARTNERIZE_STUBHUB_URL=
NEXT_PUBLIC_AFFILIATE_STUBHUB_ID=bookbyshow-sh

# ==============================================================================
# Google AdSense Publisher Configuration
# ==============================================================================
# Set your Google AdSense Publisher Client ID once approved (e.g. ca-pub-1234567890123456)
# When set, live Google AdSense ads automatically render across BookByShow.
# Also update public/ads.txt with your publisher ID.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=